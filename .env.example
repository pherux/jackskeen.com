# Public site URL. Confirm the canonical www/non-www policy before production.
NEXT_PUBLIC_SITE_URL=https://jackskeen.com
# Keep false on local, preview, and staging. Enable only after launch SEO approval.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Keep snapshot through migration. Switch only after the complete archive has
# been imported, reviewed, and published in Sanity. No silent fallback in CMS mode.
ARTICLE_SOURCE=snapshot

# Sanity configuration (provisioning is intentionally deferred).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-31
NEXT_PUBLIC_SANITY_PREVIEW_ORIGIN=http://localhost:3000
SANITY_API_READ_TOKEN=
# Optional separate Viewer token exposed only while an authenticated editor is in preview.
# Leave blank to disable browser-side live preview updates.
SANITY_API_BROWSER_TOKEN=

# GA4 web stream ID. Loaded only when VERCEL_ENV=production; previews/local stay off.
# Keep enhanced measurement's browser-history pageviews enabled; see docs/analytics.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Form, CRM, scheduling, and spam-protection variables will be added after the
# existing Kit/CRM/Calendly workflow is reviewed and approved.
