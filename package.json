{
  "name": "jackskeen-com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:migration": "node scripts/migration/audit-site.mjs",
    "audit:migration:validate": "node scripts/migration/validate-output.mjs",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build .sanity-dist --yes",
    "sanity:schema": "sanity schema extract --path sanity/schema.json --enforce-required-fields --force",
    "sanity:typegen": "npm run sanity:schema && sanity typegen generate",
    "sanity:validate": "npm run sanity:typegen && sanity schemas validate --level error",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "next-sanity": "^13.3.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.11.0",
    "shadcn": "^4.19.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cheerio": "^1.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
